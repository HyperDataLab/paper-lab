{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperdatalab-paragraph-lab.web.app/schemas/draft-measure-v1.schema.json",
  "title": "PaperLab draft measure v1",
  "description": "Response of PaperLab's POST /v1/measure: a writer's draft measured against feature registry v2 with no LLM pass (Writing Bank B4). `$defs.request` is the request body.",
  "type": "object",
  "properties": {
    "format": { "type": "string", "const": "paperlab-draft-measure" },
    "version": { "type": "number", "const": 1 },
    "registryId": { "type": "string", "const": "paperlab-feature-registry" },
    "registryVersion": { "type": "number", "const": 2 },
    "registryDigest": { "type": "string" },
    "title": { "type": ["string", "null"] },
    "features": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "value": { "type": "number" },
              "status": { "type": "string", "const": "measured" }
            },
            "required": ["id", "value", "status"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "value": { "type": "null" },
              "status": { "type": "string", "const": "unavailable" },
              "reason": {
                "type": "string",
                "enum": ["needs_llm_pass", "grammar_service_unavailable", "no_data"]
              }
            },
            "required": ["id", "value", "status", "reason"],
            "additionalProperties": false
          }
        ]
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "line": {
            "anyOf": [
              { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "heading": { "type": ["string", "null"] },
          "title": { "type": "string" },
          "level": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
          "role": {
            "type": "string",
            "enum": [
              "ABSTRACT",
              "INTRODUCTION",
              "RELATED_WORK",
              "METHODS",
              "RESULTS",
              "DISCUSSION",
              "CONCLUSION",
              "OTHER",
              "APPENDIX"
            ]
          },
          "counted": { "type": "boolean" },
          "paragraphs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "words": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "required": ["index", "line", "heading", "title", "level", "role", "counted", "paragraphs", "words"],
        "additionalProperties": false
      }
    },
    "grammar": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["parsed", "not_configured", "failed"] },
        "parser": { "type": ["string", "null"] },
        "sentences": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "parsed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["status", "parser", "sentences", "parsed"],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "no_headings",
              "text_before_first_heading",
              "title_heading_lifted",
              "unrecognised_headings",
              "excluded_sections",
              "non_body_blocks",
              "grammar_partial",
              "grammar_service_failed"
            ]
          },
          "message": { "type": "string" },
          "sections": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          }
        },
        "required": ["code", "message"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "version",
    "registryId",
    "registryVersion",
    "registryDigest",
    "title",
    "features",
    "sections",
    "grammar",
    "warnings"
  ],
  "additionalProperties": false,
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "format": { "type": "string", "enum": ["markdown", "text"] },
        "text": { "type": "string" },
        "title": { "type": "string", "maxLength": 500 }
      },
      "required": ["format", "text"],
      "additionalProperties": false
    }
  }
}
