{
  "name": "paragraph-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "typecheck:worker": "tsc -p worker",
    "build": "tsc -b && vite build",
    "check:router-cors": "node scripts/check-router-cors.mjs",
    "check:cycles": "node scripts/check-cycles.mjs",
    "schema:paper-model": "node scripts/paper-model-schema.mjs",
    "schema:corpus": "node scripts/paper-model-schema.mjs",
    "schema:corpus-profile": "node scripts/paper-model-schema.mjs",
    "bench:arguments": "node scripts/bench-arguments.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
