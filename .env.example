# Browser settings
VITE_LLM_BASE_URL=/llm
VITE_LLM_MODEL=cx/gpt-6-luna

# HyperDataLab SSO (register http://localhost:5173/auth/callback with the SSO provider)
VITE_HYPERDATALAB_SSO_BASE_URL=https://rpr-grobid-gateway.hpl-storage.workers.dev
VITE_HYPERDATALAB_SSO_CLIENT_ID=replace-after-register
VITE_HYPERDATALAB_SSO_CALLBACK_URL=http://localhost:5173/auth/callback

# ResearchHub project portal and exact origins allowed to hand off an SSO session.
VITE_RESEARCH_HUB_URL=https://researchhub.hyperdatalab.org
VITE_RESEARCH_HUB_ORIGINS=https://researchhub.hyperdatalab.org,http://localhost:3000

# PaperLab Worker, including shared ResearchHub project workspaces
VITE_PDF_WORKER_URL=https://paperlab-pdf-worker.hyperdatalab.workers.dev

# Development proxy only; never prefix the key with VITE_
LLM_PROXY_TARGET=
LLM_PROXY_API_KEY=

# Optional lab research server; leave empty when not deployed.
VITE_LAB_RESEARCH_URL=

# Optional spaCy parse service (topics worker, POST /nlp/parse); leave empty when not deployed.
VITE_NLP_URL=
