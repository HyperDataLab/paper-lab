# Browser settings
VITE_LLM_BASE_URL=/llm
VITE_LLM_MODEL=cx/gpt-6-luna

# Development proxy only; never prefix the key with VITE_
LLM_PROXY_TARGET=
LLM_PROXY_API_KEY=

# Optional lab research server; leave empty when not deployed.
VITE_LAB_RESEARCH_URL=

# Optional spaCy parse service (topics worker, POST /nlp/parse); leave empty when not deployed.
VITE_NLP_URL=
