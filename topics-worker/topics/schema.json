{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperdatalab-paragraph-lab.web.app/schemas/corpus-topics-v1.schema.json",
  "title": "PaperLab corpus topics, version 1",
  "type": "object",
  "properties": {
    "format": { "type": "string", "const": "paperlab-corpus-topics" },
    "schemaVersion": { "type": "number", "const": 1 },
    "snapshotId": { "type": "string", "minLength": 1 },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "corpora": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "corpusId": { "type": "string" },
          "releaseId": { "type": "string" },
          "kind": { "type": "string", "enum": ["journal", "control", "topic"] },
          "title": { "type": "string" }
        },
        "required": ["corpusId", "kind", "title"],
        "additionalProperties": false
      }
    },
    "pipeline": {
      "type": "object",
      "properties": {
        "tag": { "type": "string" },
        "embeddingModel": { "type": "string" },
        "parameters": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "seed": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        "textSource": { "type": "string", "enum": ["abstract", "full-text"] },
        "openalexFetchedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": ["tag", "embeddingModel", "parameters", "seed", "textSource", "openalexFetchedAt"],
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "nmiVsOpenalexSubfield": { "type": "number", "minimum": 0, "maximum": 1 },
        "outlierShare": { "type": "number", "minimum": 0, "maximum": 1 },
        "stability": {
          "type": "object",
          "properties": {
            "comparedSeed": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
            "matchedTopicShare": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["comparedSeed", "matchedTopicShare"],
          "additionalProperties": false
        }
      },
      "required": ["outlierShare"],
      "additionalProperties": false
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topicId": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "byCorpus": {
            "type": "object",
            "propertyNames": { "type": "string" },
            "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          },
          "words": { "maxItems": 10, "type": "array", "items": { "type": "string" } },
          "representativeMemberIds": { "maxItems": 5, "type": "array", "items": { "type": "string" } },
          "openalexSubfields": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
              },
              "required": ["name", "count"],
              "additionalProperties": false
            }
          }
        },
        "required": ["topicId", "size", "byCorpus", "words", "representativeMemberIds", "openalexSubfields"],
        "additionalProperties": false
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "corpusId": { "type": "string" },
          "memberId": { "type": "string" },
          "topicId": { "type": "integer", "minimum": -1, "maximum": 9007199254740991 },
          "probability": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }] },
          "weak": { "type": "boolean" },
          "fit": { "anyOf": [{ "type": "number", "minimum": -1, "maximum": 1 }, { "type": "null" }] },
          "weakReason": {
            "anyOf": [
              { "type": "string", "enum": ["closer-to-other-topic", "low-fit", "unassigned"] },
              { "type": "null" }
            ]
          },
          "keyphrases": { "maxItems": 8, "type": "array", "items": { "type": "string" } },
          "textUsed": { "type": "string", "enum": ["abstract", "title-only", "none"] }
        },
        "required": ["corpusId", "memberId", "topicId", "probability", "weak", "keyphrases", "textUsed"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "snapshotId",
    "createdAt",
    "corpora",
    "pipeline",
    "quality",
    "topics",
    "members"
  ],
  "additionalProperties": false
}
